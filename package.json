{
  "name": "buckit-v3",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pre": "oxfmt && oxlint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply buckit --local",
    "db:migrate:remote": "wrangler d1 migrations apply buckit --remote",
    "db:studio": "drizzle-kit studio",
    "db:list-tables": "wrangler d1 execute buckit --local --command \"SELECT name FROM sqlite_schema WHERE type='table' AND name NOT LIKE 'sqlite_%';\"",
    "db:seed": "tsx scripts/seed.ts",
    "db:pull:prod": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply buckit --local && wrangler d1 export buckit --remote --no-schema --output=.wrangler/prod-dump.sql && bash scripts/strip-d1-migrations.sh .wrangler/prod-dump.sql .wrangler/prod-dump.filtered.sql && wrangler d1 execute buckit --local --file=.wrangler/prod-dump.filtered.sql"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@cloudflare/vite-plugin": "1.57.3",
    "@faker-js/faker": "10.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tabler/icons-react": "3.48.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-devtools": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.57",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/router-plugin": "1.168.40",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@libsql/client": "0.17.4",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.38",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "28.1.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.85.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
