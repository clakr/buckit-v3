{
  "name": "buckit-v3",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pre": "oxfmt && oxlint",
    "db:migrate:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply buckit --local",
    "db:migrate:remote": "wrangler d1 migrations apply buckit --remote",
    "db:studio": "drizzle-kit studio",
    "db:tables:list": "wrangler d1 execute buckit --local --command \"SELECT name FROM sqlite_schema WHERE type='table' AND name NOT LIKE 'sqlite_%';\"",
    "db:seed": "tsx scripts/seed.ts",
    "db:pull:prod": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply buckit --local && wrangler d1 export buckit --remote --no-schema --output=.wrangler/prod-dump.sql && bash scripts/strip-d1-migrations.sh .wrangler/prod-dump.sql .wrangler/prod-dump.filtered.sql && wrangler d1 execute buckit --local --file=.wrangler/prod-dump.filtered.sql"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/intent": "0.5.6",
    "@tanstack/router-cli": "1.167.45",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "drizzle-kit"
    ],
    "exclude": [
      "@tanstack/devtools-event-client"
    ]
  }
}
